DEBUG=True
SECRET_KEY=django-insecure-sprintmind-phase0-local-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL connection string (pooled connection with SSL mode required)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/sprintmind?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/sprintmind?sslmode=require

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq API configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_HOUR=20

# Production Security
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# JWT Token Lifespans
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

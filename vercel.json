{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sprintmind-api": {
      "root": "backend",
      "framework": "django",
      "buildCommand": "python manage.py collectstatic --no-input"
    },
    "sprintmind-ui": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "sprintmind-api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "sprintmind-api"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "sprintmind-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "sprintmind-ui"
      }
    }
  ]
}
